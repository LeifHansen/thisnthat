# --- Database (Neon) ---
# Pooled connection string (used at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (used for prisma migrate / db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key. Read on the server at REQUEST time and passed to the checkout
# components, so setting it on the running app (`fly secrets set`) takes effect
# on the next request with no rebuild. Unprefixed on purpose: a NEXT_PUBLIC_ name
# would be inlined into the bundle at build time and could not be fixed without
# rebuilding the image.
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` (local) or the Vercel webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Cloudflare R2 (image upload, S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="beaniexchange-uploads"
# Public URL prefix (R2 public bucket "pub-xxx.r2.dev" OR custom domain like https://images.beaniexchange.com)
R2_PUBLIC_URL=""

# --- AI listing tools (OpenAI) ---
# Powers the "auto-fill from photos" / description writer. Either name works.
OPENAI_API_KEY=""
# Image model for the blog hero and admin beanie-image tools. Defaults to
# gpt-image-1; set to e.g. dall-e-3 if your account lacks access to it.
OPENAI_IMAGE_MODEL=""

# --- Studio photo optimizer (background removal, optional) ---
# Powers the "Studio-optimize photos" checkbox on the Sell page: cuts the item
# out of its background, centers it on a studio backdrop, and adds a drop
# shadow. Segmentation only (the item's real pixels are preserved). Configure
# ONE provider; leave both blank to hide/disable the feature.
#   remove.bg — https://www.remove.bg/api
REMOVE_BG_API_KEY=""
#   OR a self-hosted endpoint that accepts multipart `image` and returns a PNG
#   with alpha (e.g. a rembg server or a Worker). Optional bearer token.
BG_REMOVAL_ENDPOINT=""
BG_REMOVAL_TOKEN=""

# --- eBay sold comps (RapidAPI, optional) ---
# Grounds pricing in real eBay completed/sold listings via the third-party
# "ebay-average-selling-price" RapidAPI service. Powers the listing assistant's
# price suggestion, the /price-trends dashboard, and the data-driven price guide
# on /database (ingest with `npm run sold:ingest`). Leave blank to fall back to
# AI/database estimates only. Either name works (RAPIDAPI_KEY or RAPID_API_KEY).
RAPIDAPI_KEY=""
# RapidAPI host for the sold-comps service (defaults to the ebay-average-
# selling-price host; override only if the service moves).
RAPIDAPI_EBAY_HOST=""

# --- App ---
# Public base URL (used for Stripe Connect return links). Optional locally.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical origin used server-side for links in emails and unsubscribe URLs.
# Defaults to https://beaniexchange.com when unset.
SITE_URL=""
# The single account allowed to manage users (roles, suspension, deletion).
# Defaults to admin@beaniexchange.com — set this explicitly in production.
SUPERADMIN_EMAIL=""

# --- Transactional email (SendGrid) ---
# Sends order receipts, "you sold an item", offer, refund and label emails.
# When the key is unset every send is a logged no-op, so the app runs fine
# locally but silently sends nothing — set it in production.
SENDGRID_API_KEY=""
# From address on every transactional email (default notifications@beaniexchange.com).
SENDGRID_FROM=""
# Set to 1 to exercise the wiring against a real key without delivering mail.
SENDGRID_SANDBOX=""

# --- Analytics (Google Analytics 4) ---
# GA4 measurement ID (e.g. G-XXXXXXXXXX). Set this to point the tag at a
# different/new GA4 property without a code change. If unset or empty it falls
# back to the built-in stream, so analytics is never accidentally disabled.
# NEXT_PUBLIC_* is baked at build time — in prod it's wired as a Dockerfile ARG
# + a fly-deploy --build-arg from the NEXT_PUBLIC_GA_ID GitHub secret.
NEXT_PUBLIC_GA_ID=""

# --- HQ shipping address (optional overrides) ---
# Origin/destination for authentication shipping labels (must be a real,
# complete address for EasyPost to rate & buy labels in production).
HQ_LINE1="1 Beanie HQ Way"
HQ_CITY="Vancouver"
HQ_STATE="WA"
HQ_POSTAL="98660"

# --- EasyPost (authentication shipping) ---
# Rates the round trip (submitter <-> HQ) at checkout and buys return labels.
# Without it, shipping falls back to a flat rate and labels are entered by hand.
EASYPOST_API_KEY=""
# HMAC secret for the delivery webhook (EasyPost dashboard → Webhooks). The
# endpoint returns 503 until this is set, so without it delivery scans never
# arrive — inbound packages don't advance to AT_CENTER and escrow release falls
# back to the buyer's "confirm receipt" click.
EASYPOST_WEBHOOK_SECRET=""
