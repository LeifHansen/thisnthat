# ThisNThat environment variables
#
# Local dev: copy to `.env.local` and fill in.
# Production: set these as Fly.io secrets, e.g.
#   fly secrets set DATABASE_URL=... AUTH_SECRET=... --app thisnthat
#
# The app runs in read-only "browse" mode against seed data until DATABASE_URL
# is set, so you can develop the UI before provisioning anything.

# --- Neon (Postgres) ---
# Pooled connection string from the Neon dashboard.
DATABASE_URL=

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public base URL of the app (e.g. https://thisnthat.fly.dev)
AUTH_URL=
# Google OAuth credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# This email is always promoted to platform super admin (on sign-in and via
# `npm run db:create-admin`).
SUPER_ADMIN_EMAIL=admin@thisnthat.com
# Passwordless email sign-in for local testing ONLY. Never set in production.
ALLOW_DEV_LOGIN=

# --- Cloudflare R2 (listing images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public host of the bucket/CDN, e.g. images.thisnthat.com (no protocol)
R2_PUBLIC_HOST=

# --- Google Gemini (AI listing assistant: photo scan -> auto-fill) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=

# --- Stripe Connect (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform fee taken from each sale, in basis points (800 = 8%)
PLATFORM_FEE_BPS=800
