{
  "expo": {
    "name": "Beanie Xchange",
    "slug": "beanie-xchange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beaniex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.beaniexchange.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Beanie Xchange needs access to your photos so you can add pictures of the beanies you list for sale.",
        "NSCameraUsageDescription": "Beanie Xchange needs access to your camera so you can photograph the beanies you list for sale."
      }
    },
    "android": {
      "package": "com.beaniexchange.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#faf5ec",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf5ec",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#161320",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
